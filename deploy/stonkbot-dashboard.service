[Unit]
Description=stonkbot dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/nas/filip/ncdata/filip/files/Projects/stonkbot
ExecStart=/usr/local/bin/bun run src/dashboard.ts
EnvironmentFile=/media/nas/filip/ncdata/filip/files/Projects/stonkbot/.env
Restart=on-failure
RestartSec=15
User=filip

[Install]
WantedBy=multi-user.target
