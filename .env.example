# Copy to .env and fill in. .env is gitignored, never commit real keys.

# --- Alpaca (PAPER keys to start) ---
# Get these from https://alpaca.markets -> Paper Trading -> API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Paper endpoints (leave as-is until you deliberately go live).
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Home Assistant notifications ---
# A Long-Lived Access Token from HA (profile -> Security -> Long-lived tokens)
# and the notify service to call (e.g. notify.mobile_app_filip_phone).
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_NOTIFY_SERVICE=notify.notify

# --- AI news classifier ---
# Points at the host-side shim (stonkbot-classifier.service) that runs
# `claude --print` under Filip's Claude subscription (no API key needed). The
# container reaches the host via host.docker.internal. Leave blank to fall back
# to the dumb "3+ headlines = skip" count heuristic. Token must match the shim's
# CLASSIFIER_TOKEN in /home/filip/stonkbot-classifier/.env.
CLASSIFIER_URL=http://host.docker.internal:8772/classify
CLASSIFIER_TOKEN=

# --- Dashboard ---
DASHBOARD_PORT=8770

# --- Safety ---
# Hard master switch. Set to false to halt all order placement instantly.
TRADING_ENABLED=true
# 'paper' or 'live'. Going 'live' is a deliberate, separate decision.
MODE=paper

# --- ntfy push notifications (buy/sell alerts) ---
# Subscribe to NTFY_TOPIC in the ntfy app (or the web) to get alerts.
# NTFY_URL can point at a self-hosted ntfy later. NTFY_TOKEN optional.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
